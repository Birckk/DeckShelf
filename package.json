{
  "name": "deckshelf",
  "private": true,
  "version": "1.0.0",
  "description": "A personal Commander collection viewer and deck picker",
  "author": "Bircck",
  "license": "MIT",
  "main": "desktop/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "tsc -b && vp build",
    "start": "node server/index.mjs",
    "mcp": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/mcp.mjs",
    "preview": "vp preview --host 127.0.0.1",
    "check": "vp check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:dialogs": "playwright test",
    "desktop": "npm run runtime && npm run build && electron .",
    "runtime": "node node_modules/electron/install.js",
    "notices": "node scripts/notices.mjs",
    "package:windows": "npm run runtime && npm run build && npm run notices && electron-builder --config desktop/electron-builder.yml --win --x64 --publish never && node scripts/release-assets.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "catalog:update": "node --experimental-strip-types scripts/precon-catalog.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
